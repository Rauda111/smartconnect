{
  "complete": true,
  "caption": "Controlled simulation results using realistic assumed Wi-Fi and 5G-like network conditions.",
  "source": {
    "commit": "ac860776ba1d168cfa2e1dea8a496c9fa086d7d9",
    "file_sha256": {
      "simulate.py": "6e5d3e7e656498c96d14074307938d95299dba4b9a9264b8e724323a3de07a11",
